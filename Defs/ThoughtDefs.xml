<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL DRAFT - NOT THOROUGHLY TESTED
     These values are initial guesses for high-frequency social interactions.
     They may be completely wrong and need adjustment based on actual gameplay.
     If you have better data or balance suggestions, please share feedback! -->
<Defs>
    <ThoughtDef>
        <defName>RimTalk_Chitchat</defName>
        <thoughtClass>Thought_MemorySocialCumulative</thoughtClass>
        <showBubble>true</showBubble>
        <durationDays>1</durationDays>
        <stackLimit>50</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <nullifyingTraits>
            <li>Psychopath</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>chitchat+</label>
                <baseMoodEffect>0</baseMoodEffect>
                <baseOpinionOffset>0.1</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_KindWords</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <showBubble>true</showBubble>
        <durationDays>1</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>kind words+</label>
                <description>I've been bestowed with kind words! What a nice person!(RimTalk)</description>
                <baseMoodEffect>3</baseMoodEffect>
                <baseOpinionOffset>3</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_Slighted</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <showBubble>true</showBubble>
        <durationDays>1</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <stages>
            <li>
                <label>slighted+</label>
                <description>I've been ignored! That hurt my feelings. (RimTalk)</description>
                <baseMoodEffect>-3</baseMoodEffect>
                <baseOpinionOffset>-3</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <!-- rim-universe #28. The first thing RimTalk has ever done that the GAME can
         see, which is #29's exit criterion for the whole tracker.

         Tiny and asymmetric on purpose. #28 names two hazards: taxing the player for
         playing their own way, and a permanent mood floor nobody asked for. A short
         memory with stackLimit 1 answers both, and a goal met is a bigger event than
         a goal missed because a miss is mostly just disappointing. -->
    <ThoughtDef>
        <defName>RimTalk_GoalMet</defName>
        <durationDays>5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>got what I wanted</label>
                <description>I set out to see something happen here, and it happened. (RimTalk)</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_GoalMissed</defName>
        <durationDays>3</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>never got round to it</label>
                <description>I wanted something to happen here and it never did. (RimTalk)</description>
                <baseMoodEffect>-2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>
</Defs>
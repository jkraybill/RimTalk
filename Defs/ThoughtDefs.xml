<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL DRAFT - NOT THOROUGHLY TESTED
     These values are initial guesses for high-frequency social interactions.
     They may be completely wrong and need adjustment based on actual gameplay.
     If you have better data or balance suggestions, please share feedback! -->
<Defs>
    <ThoughtDef>
        <defName>RimTalk_Chitchat</defName>
        <thoughtClass>Thought_MemorySocialCumulative</thoughtClass>
        <showBubble>true</showBubble>
        <durationDays>1</durationDays>
        <stackLimit>50</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <nullifyingTraits>
            <li>Psychopath</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>chitchat+</label>
                <baseMoodEffect>0</baseMoodEffect>
                <baseOpinionOffset>0.1</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_KindWords</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <showBubble>true</showBubble>
        <durationDays>1</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>kind words+</label>
                <description>I've been bestowed with kind words! What a nice person!(RimTalk)</description>
                <baseMoodEffect>3</baseMoodEffect>
                <baseOpinionOffset>3</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_Slighted</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <showBubble>true</showBubble>
        <durationDays>1</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <stages>
            <li>
                <label>slighted+</label>
                <description>I've been ignored! That hurt my feelings. (RimTalk)</description>
                <baseMoodEffect>-3</baseMoodEffect>
                <baseOpinionOffset>-3</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <!-- rim-universe #28. The first thing RimTalk has ever done that the GAME can
         see, which is #29's exit criterion for the whole tracker.

         Tiny and asymmetric on purpose. #28 names two hazards: taxing the player for
         playing their own way, and a permanent mood floor nobody asked for. A short
         memory with stackLimit 1 answers both, and a goal met is a bigger event than
         a goal missed because a miss is mostly just disappointing. -->
    <ThoughtDef>
        <defName>RimTalk_GoalMet</defName>
        <durationDays>5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>got what I wanted</label>
                <description>I set out to see something happen here, and it happened. (RimTalk)</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_GoalMissed</defName>
        <durationDays>3</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>never got round to it</label>
                <description>I wanted something to happen here and it never did. (RimTalk)</description>
                <baseMoodEffect>-2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <!-- rim-universe #22 + #31 Social. Gossip that moved an opinion.

         Small offsets and a low stack limit on purpose: this is the first thing in
         the mod that writes to the simulation, and the cap plus the decay are what
         stop a rumour mill from driving the colony to the ends of the scale. Two
         points, four deep, gone in eight days. -->
    <ThoughtDef>
        <defName>RimTalk_GossipHeardGood</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>8</durationDays>
        <stackLimit>4</stackLimit>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <stages>
            <li>
                <label>heard something good</label>
                <description>I heard something that made me think better of them. (RimTalk)</description>
                <baseOpinionOffset>2</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_GossipHeardBad</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>8</durationDays>
        <stackLimit>4</stackLimit>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <stages>
            <li>
                <label>heard something bad</label>
                <description>I heard something that made me think worse of them. (RimTalk)</description>
                <baseOpinionOffset>-2</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <!-- About the SPEAKER, not the subject. Being kept in the loop is worth a little;
         being the one who is always talking about people costs a little more. -->
    <ThoughtDef>
        <defName>RimTalk_GossipToldMe</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <stages>
            <li>
                <label>tells me things</label>
                <description>They tell me what is going on around here. (RimTalk)</description>
                <baseOpinionOffset>1</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>RimTalk_GossipTalksAboutPeople</defName>
        <thoughtClass>Thought_MemorySocial</thoughtClass>
        <durationDays>6</durationDays>
        <stackLimit>3</stackLimit>
        <developmentalStageFilter>Child, Adult</developmentalStageFilter>
        <socialTargetDevelopmentalStageFilter>Baby, Child, Adult</socialTargetDevelopmentalStageFilter>
        <stages>
            <li>
                <label>talks about people</label>
                <description>They talk about people behind their backs. (RimTalk)</description>
                <baseOpinionOffset>-2</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>
</Defs>
